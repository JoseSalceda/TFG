@startuml MisionFinOps
hide empty description

[*] --> pending : Mision creada

pending --> ready : Disponible en catalogo

ready --> preparing : Usuario inicia recorrido
preparing --> analyzing : Verificaciones iniciales
analyzing --> in_progress : Datos o accion disponibles

in_progress --> waiting : Falta dato externo o confirmacion
waiting --> in_progress : Condicion resuelta

in_progress --> complete : Evidencia revisada
in_progress --> failed : Error recuperable no resuelto
waiting --> failed : Condicion expirada

complete --> active : Mision ongoing activada
active --> degraded : Health check fallido
degraded --> active : Health check recuperado

failed --> [*]
complete --> [*]
active --> [*] : Mision cancelada

@enduml
