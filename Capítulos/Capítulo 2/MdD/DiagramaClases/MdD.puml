@startuml MdD
hide circle
hide empty members
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 80

class Organizacion {
  nombre
  industria
  tamano
  mercado_principal
  tolerancia_riesgo
}

class Usuario {
  email
  nombre
  rol
  es_admin: bool
}

class CredencialAWS {
  nombre
  proveedor: aws
  region
  valida: bool
  ultima_verificacion
}

class AgenteIA {
  nombre
  tipo: bedrock-agent
  estado
  region
  modelo_fundacional
  rol_ARN
  punto_acceso
}

class MisionFinOps {
  mission_id
  titulo
  estado_usuario
  progreso
  pantalla_revision: Costs
  ultimo_cambio
}

class DatoFacturacion {
  agente_asociado: opcional
  proveedor
  recurso_id
  periodo_inicio
  periodo_fin
  coste
  moneda
  servicio: Amazon Bedrock
  tipo_uso
}

class RegistroUsoLLM {
  proveedor
  modelo
  tokens_entrada
  tokens_salida
  coste_usd
  fuente
}

class ConfiguracionLLM {
  proveedor
  modelo
  punto_acceso
  clave_cifrada
  rol_asignado
}

class RegistroAuditoria {
  accion
  tipo_recurso
  recurso_id
  detalles
}

Organizacion "1" --> "0..*" Usuario : contiene
Organizacion "1" --> "0..*" CredencialAWS : posee
Organizacion "1" --> "0..*" MisionFinOps : lanza
Organizacion "1" --> "0..*" ConfiguracionLLM : configura
Organizacion "1" --> "0..*" RegistroUsoLLM : acumula
Organizacion "1" --> "0..*" DatoFacturacion : acumula
Organizacion "1" --> "0..*" RegistroAuditoria : registra

CredencialAWS "1" --> "0..*" AgenteIA : descubre
MisionFinOps "0..*" --> "0..*" RegistroAuditoria : deja evidencia

AgenteIA "0..1" <-- "0..*" DatoFacturacion : atribuido si existe

ConfiguracionLLM "1" --> "0..*" RegistroUsoLLM : genera

@enduml
