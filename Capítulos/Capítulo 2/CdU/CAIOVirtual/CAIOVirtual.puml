@startuml CAIOVirtual
left to right direction
skinparam packageStyle rectangle

actor "CAIO Virtual" as CAIO

rectangle "Sistema de Gobierno IA - Modulo FinOps AWS" {
  rectangle "Plataforma base (Theia Craft)" {
    usecase "CU-03\nGestionar permisos IAM" as CU03
  }
  rectangle "Nuevas misiones FinOps (TFG)" {
    usecase "CU-09\nDetectar anomalias de gasto" as CU09
    usecase "CU-11\nOptimizar recuperacion RAG" as CU11
    usecase "CU-12\nPrompt caching controlado" as CU12
    usecase "CU-13\nProyectar tendencia (futuro)" as CU13
    usecase "CU-14\nConfigurar alertas (futuro)" as CU14
  }
}

CAIO --> CU03
CAIO --> CU09
CAIO --> CU11
CAIO --> CU12
CAIO ..> CU13
CAIO ..> CU14

@enduml
