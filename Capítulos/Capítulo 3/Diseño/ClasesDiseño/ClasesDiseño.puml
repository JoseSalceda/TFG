@startuml ClasesDiseno

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

title Clases de diseno - Modulo FinOps

package "API" {
  class BillingRouter {
    +GET /api/v1/billing/status
    +GET /api/v1/billing/costs
    +GET /api/v1/billing/total
    +GET /api/v1/billing/agents
    +GET /api/v1/billing/dashboard
    +GET /api/v1/billing/anomalies
    +POST /api/v1/billing/anomalies/run
    +POST /api/v1/billing/sync
  }
}

package "Servicios" {
  class BillingService {
    +get_status()
    +get_costs()
    +get_total()
    +get_agent_costs()
    +get_anomalies()
    +run_anomaly_check()
    +sync()
  }

  class AWSBillingService {
    +fetch_costs()
    +fetch_anomalies()
  }

}

package "Persistencia" {
  class BillingRepository {
    +get_by_period()
    +upsert_cost()
  }

  class BillingData {
    organizationId
    provider
    resourceId
    agentId nullable
    period
    cost
    serviceName
  }

  class Agent
  class BillingAnomalyRun
  class AuditLog
}

package "Schemas" {
  class BillingStatusResponse
  class BillingCostSummary
  class BillingTotalResponse
  class BillingAgentsResponse
  class BillingAnomalyResponse
  class BillingAnomalyRunResponse
}

BillingRouter --> BillingService
BillingRouter --> BillingStatusResponse
BillingRouter --> BillingCostSummary
BillingRouter --> BillingTotalResponse
BillingRouter --> BillingAgentsResponse
BillingRouter --> BillingAnomalyResponse
BillingRouter --> BillingAnomalyRunResponse

BillingService --> BillingRepository
BillingService --> AWSBillingService : sincronizacion
BillingService --> Agent : matching
BillingService --> BillingAnomalyRun : idempotencia CU-09
BillingService --> AuditLog : auditoria

BillingRepository --> BillingData
BillingData --> Agent : agent_id opcional

@enduml
