@startuml PaquetesBackend

skinparam packageStyle rectangle

title Paquetes backend - Modulo FinOps

package "api/v1" {
  component "billing.py" as API
  component "llm.py" as LLMAPI
  component "agents.py" as AgentsAPI
}

package "services" {
  component "BillingService" as Service
  component "AWSBillingService" as AWS
  component "LLMCostService" as LLMCost
  component "BedrockAgentOptimizationService" as Optimization
}

package "repositories" {
  component "BillingRepository" as Repo
  component "LLMUsageLogRepository" as LLMRepo
  component "AgentRepository" as AgentRepo
}

package "models" {
  component "BillingData" as Model
  component "BillingAnomalyRun" as Run
  component "LLMUsageLog" as LLMLog
  component "Agent" as Agent
  component "Credential" as Credential
  component "AuditLog" as Audit
}

package "schemas" {
  component "Billing schemas" as Schemas
  component "LLM cost schemas" as LLMSchemas
  component "Agent optimization schemas" as AgentSchemas
}

API --> Service
API --> Schemas
LLMAPI --> LLMCost
LLMAPI --> LLMSchemas
AgentsAPI --> Optimization
AgentsAPI --> AgentSchemas

Service --> Repo
Service --> AWS
Service --> Run
Service --> Audit
Repo --> Model
Model --> Agent

LLMCost --> LLMRepo
LLMRepo --> LLMLog

Optimization --> AgentRepo
Optimization --> Credential
Optimization --> Audit
AgentRepo --> Agent

@enduml
