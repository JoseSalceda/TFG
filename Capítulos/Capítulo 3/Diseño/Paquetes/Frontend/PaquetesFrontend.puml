@startuml PaquetesFrontend

skinparam packageStyle rectangle

title Paquetes frontend - Modulo FinOps

package "app/(dashboard)/costs" {
  component "page.tsx" as Page
}

package "hooks" {
  component "use-billing.ts" as BillingHook
  component "use-llm-costs.ts" as LLMHook
  component "use-agent-optimization.ts" as OptimizationHook
  component "use-agents.ts" as AgentsHook
  component "use-missions.ts" as MissionsHook
}

package "lib" {
  component "api-client.ts" as Api
  component "missions.ts" as Missions
  component "types.ts" as Types
}

Page --> BillingHook
Page --> LLMHook
Page --> OptimizationHook
Page --> AgentsHook
Page --> MissionsHook
Page --> Missions
Page --> Types
BillingHook --> Api
LLMHook --> Api
OptimizationHook --> Api
AgentsHook --> Api
MissionsHook --> Api

@enduml
