@startuml DS-CU07

title Secuencia - CU-07 Coste total de IA en AWS

actor Usuario
participant "Frontend /costs" as UI
participant "Hook useBillingTotal" as Hooks
participant "Billing API" as API
participant "BillingService" as Service
participant "BillingRepository" as Repo
database "billing_data" as DB

Usuario -> UI : abre pagina Costs
UI -> Hooks : solicita coste total
Hooks -> API : GET /api/v1/billing/total
API -> Service : calcular coste total
Service -> Repo : consultar periodo efectivo
Repo -> DB : SELECT
DB --> Repo : registros Bedrock
Repo --> Service : costes
Service --> API : total, moneda y registros
API --> Hooks : JSON
Hooks --> UI : datos disponibles
UI --> Usuario : muestra coste total y coste no asociado

@enduml
