@startuml ClasesAnalisis

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

title Clases de analisis MVC - Modulo FinOps

skinparam class {
  BackgroundColor<<Vista>> #EAF2FF
  BorderColor<<Vista>> #2F6FED
  BackgroundColor<<Controlador>> #EEF8EA
  BorderColor<<Controlador>> #4F8A3D
  BackgroundColor<<Modelo>> #FFF4E5
  BorderColor<<Modelo>> #C77C1A
}

package "Modelo" {
  class Organizacion <<Modelo>>
  class CredencialCloud <<Modelo>>
  class AgenteIA <<Modelo>>
  class BaseConocimiento <<Modelo>>
  class DatoFacturacion <<Modelo>>
  class EjecucionAnomalia <<Modelo>>
  class RegistroUsoLLM <<Modelo>>
  class RegistroAuditoria <<Modelo>>
}

package "Vista" {
  class VistaCostes <<Vista>>
  class VistaCatalogoFinOps <<Vista>>
  class VistaResumenCostes <<Vista>>
  class VistaRankingAgentes <<Vista>>
  class VistaAlertasAnomalia <<Vista>>
  class VistaCosteLLM <<Vista>>
  class VistaOptimizacionAgente <<Vista>>
  class VistaAuditoria <<Vista>>
}

package "Controlador" {
  class ControladorCosteTotal <<Controlador>>
  class ControladorAtribucionAgente <<Controlador>>
  class ControladorAnomalias <<Controlador>>
  class ControladorObservabilidadLLM <<Controlador>>
  class ControladorOptimizacionRAG <<Controlador>>
  class ControladorPromptCaching <<Controlador>>
  class ControladorSincronizacion <<Controlador>>
}

Organizacion "1" -- "0..*" CredencialCloud
Organizacion "1" -- "0..*" AgenteIA
Organizacion "1" -- "0..*" DatoFacturacion
Organizacion "1" -- "0..*" RegistroUsoLLM
Organizacion "1" -- "0..*" RegistroAuditoria
Organizacion "1" -- "0..*" EjecucionAnomalia

AgenteIA "0..1" -- "0..*" DatoFacturacion
AgenteIA "0..*" -- "0..*" BaseConocimiento

VistaCatalogoFinOps --> VistaCostes
VistaCostes --> ControladorCosteTotal
VistaCostes --> ControladorAtribucionAgente
VistaCostes --> ControladorAnomalias
VistaCostes --> ControladorObservabilidadLLM
VistaCostes --> ControladorOptimizacionRAG
VistaCostes --> ControladorPromptCaching
VistaResumenCostes --> DatoFacturacion
VistaRankingAgentes --> AgenteIA
VistaAlertasAnomalia --> ControladorAnomalias
VistaCosteLLM --> RegistroUsoLLM
VistaOptimizacionAgente --> AgenteIA
VistaAuditoria --> RegistroAuditoria

ControladorCosteTotal --> DatoFacturacion
ControladorAtribucionAgente --> DatoFacturacion
ControladorAtribucionAgente --> AgenteIA
ControladorSincronizacion --> CredencialCloud
ControladorSincronizacion --> RegistroAuditoria
ControladorAnomalias --> DatoFacturacion
ControladorAnomalias --> EjecucionAnomalia
ControladorAnomalias --> RegistroAuditoria
ControladorObservabilidadLLM --> RegistroUsoLLM
ControladorOptimizacionRAG --> AgenteIA
ControladorOptimizacionRAG --> BaseConocimiento
ControladorPromptCaching --> AgenteIA
ControladorPromptCaching --> RegistroAuditoria

@enduml
